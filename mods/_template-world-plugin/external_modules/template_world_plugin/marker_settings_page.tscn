[node name="RangeRow" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="RangeLabel" type="Label" parent="RangeRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "默认标记半径（格）"

[node name="RangeSpin" type="SpinBox" parent="RangeRow"]
unique_name_in_owner = true
layout_mode = 2
min_value = 1.0
max_value = 24.0
step = 1.0
value = 2.0
