[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://external_modules/template_world_plugin/marker_settings_page.gd" id="1_settings"]

[node name="MarkerSettingsPage" type="VBoxContainer"]
script = ExtResource("1_settings")
theme_override_constants/separation = 10

[node name="ShowLabelsCheck" type="CheckBox" parent="."]
